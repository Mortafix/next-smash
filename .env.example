# Percorso del database SQLite, relativo alla root del progetto oppure assoluto.
DATABASE_PATH=.data/next-smash.sqlite

# Endpoint PUC usato esclusivamente dal server durante la sincronizzazione.
PUC_API_URL=https://dp-myfit-test-function-v2.azurewebsites.net/api/v3/tornei/puc/list

# Numero massimo di giorni futuri acquisiti da PUC.
SYNC_HORIZON_DAYS=400

# Dopo quante ore una visita avvia l'aggiornamento automatico dei tornei.
TOURNAMENT_REFRESH_AFTER_HOURS=12
